{
  "name": "dracin",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev:api": "npm --workspace=apps/api run dev",
    "build:api": "npm --workspace=apps/api run build",
    "test:api": "npm --workspace=apps/api run test",
    "db:generate": "npm --workspace=packages/db run generate",
    "db:migrate": "npm --workspace=packages/db run migrate",
    "db:push": "npm --workspace=packages/db run push",
    "db:seed": "npm --workspace=packages/db run seed",
    "seed:admin": "npm --workspace=apps/api run seed:admin"
  },
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/service-worker": "^22.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@primeuix/themes": "^3.1.1",
    "hls.js": "^1.7.4",
    "primeicons": "^8.0.2",
    "primeng": "^22.1.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true
  }
}
