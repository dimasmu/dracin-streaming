# Core
NODE_ENV=development
PORT=3000
SITE_DOMAIN=localhost
APP_BASE_URL=http://localhost:4600
CORS_ORIGIN=http://localhost:4600,http://localhost:4200

# Database & Cache (REDIS_URL opsional saat dev lokal; pakai in-memory fallback jika kosong)
POSTGRES_USER=tiraiplay
POSTGRES_PASSWORD=tiraiplay_secret
POSTGRES_DB=tiraiplay
DATABASE_URL=postgres://tiraiplay:tiraiplay_secret@localhost:5432/tiraiplay
# REDIS_URL=redis://localhost:6379

# Auth & Stream Signing (wajib ganti di production minimal 32 karakter acak)
BETTER_AUTH_SECRET=change-this-better-auth-secret-32-chars-min
BETTER_AUTH_URL=http://localhost:3000
STREAM_SIGNING_SECRET=change-this-stream-signing-secret-32-chars

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 (Upload poster, backdrop, subtitle .vtt)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tiraiplay-media
R2_PUBLIC_BASE_URL=https://media.tiraiplay.example

# Payment Gateway Indie Lokal (tripay | duitku | mayar)
PAYMENT_DEFAULT_PROVIDER=tripay
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
MAYAR_API_KEY=
MAYAR_WEBHOOK_SECRET=
